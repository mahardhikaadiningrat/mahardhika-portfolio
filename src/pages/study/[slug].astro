---
import '../../styles/global.css';
import { sql } from '../../lib/db';
import { getActiveLang, getTranslatedStudy, getTranslatedCareer } from '../../lib/translator';

export const prerender = false;

const lang = getActiveLang(Astro.url, Astro.cookies);
const isEn = lang === 'en';

const { slug } = Astro.params;
const decodedSlug = decodeURIComponent(slug || '');

const rows = await sql`SELECT * FROM case_studies WHERE slug = ${decodedSlug} LIMIT 1`;
const rawStudy = rows[0];

if (!rawStudy) {
  return Astro.redirect(`/?lang=${lang}`);
}

const study = isEn ? await getTranslatedStudy(rawStudy) : rawStudy;

const careerRows = study.career_id
  ? await sql`SELECT * FROM careers WHERE id = ${study.career_id} LIMIT 1`
  : [];
const career = careerRows[0]
  ? isEn
    ? await getTranslatedCareer(careerRows[0])
    : careerRows[0]
  : null;

function parseBulletPoints(raw: unknown): string[] {
  const list = Array.isArray(raw) ? raw : typeof raw === 'string' ? [raw] : [];
  const output: string[] = [];

  for (const item of list) {
    const text = String(item || '').trim();
    if (!text) continue;

    const lines = text.split(/\r?\n+/);

    for (const line of lines) {
      const separated = line.replace(/\.([A-Z])/g, '.\n$1').split('\n');
      for (const part of separated) {
        const cleaned = part.replace(/^[\s•\-\*\u2022\u25CF\d\.]+/, '').trim();
        if (cleaned) output.push(cleaned);
      }
    }
  }

  return output;
}

const photos: { url: string; caption?: string }[] = Array.isArray(study.photos)
  ? study.photos
  : [];
const execution: string[] = parseBulletPoints(study.execution);
const results: string[] = parseBulletPoints(study.results);
const categories: string[] = Array.isArray(study.categories) ? study.categories : [];

const t = {
  navCareers: isEn ? 'Focused Career' : 'Fokus Karier',
  navStudies: isEn ? 'Selected Case Studies' : 'Studi Kasus Pilihan',
  footerStudies: isEn ? 'Case Studies' : 'Studi Kasus',
  navContact: isEn ? 'Contact' : 'Kontak',
  navLinkedin: isEn ? 'Connect on LinkedIn' : 'Connect ke LinkedIn',
  backPortfolio: isEn ? '← Back to Portfolio' : '← Kembali ke Portfolio',
  visitLive: isEn ? 'Visit Live Website / Project' : 'Kunjungi Website / Proyek Live',
  visualHeading: isEn ? 'Visuals & Project Documentation' : 'Visual & Dokumentasi Proyek',
  zoomHint: isEn ? 'Click image to enlarge' : 'Klik gambar untuk memperbesar',
  secChallenge: isEn ? '01 • Challenge & Background' : '01 • Tantangan & Latar Belakang',
  secExecution: isEn ? '02 • Execution & Scope of Work' : '02 • Penjabaran Pekerjaan',
  secResults: isEn ? '03 • Impact & Results' : '03 • Dampak & Hasil Pekerjaan',
  ctaTitle: isEn ? 'Interested in discussing a similar case study?' : 'Tertarik mendiskusikan studi kasus serupa?',
  ctaDesc: isEn
    ? 'Reach out directly for marketing strategy or digital system development consultations.'
    : 'Hubungi langsung untuk konsultasi strategi pemasaran atau pengembangan sistem digital.',
  ctaEmail: isEn ? 'Send Email →' : 'Kirim Email →',
  ctaMore: isEn ? 'More Case Studies' : 'Studi Kasus Lainnya',
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{study.title} — Mahardhika Adiningrat</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={study.subtitle || study.challenge || study.title} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${study.title} — Mahardhika Adiningrat`} />
    <meta property="og:description" content={study.subtitle || study.challenge || study.title} />
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white/95 backdrop-blur sticky top-0 z-40">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href={`/?lang=${lang}`} class="gsap-logo inline-flex items-center gap-2.5 group" aria-label="Mahardhika Adiningrat Home">
          <span class="w-9 h-9 rounded-xl bg-slate-900 text-white font-bold text-sm tracking-wider flex items-center justify-center shadow-xs group-hover:bg-emerald-600">
            MA
          </span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-6 text-sm">
          <a href={`/?lang=${lang}#careers`} class="gsap-nav text-slate-600 hover:text-slate-900 font-medium">{t.navCareers}</a>
          <a href={`/?lang=${lang}#studies`} class="gsap-nav text-slate-600 hover:text-slate-900 font-medium">{t.navStudies}</a>
          <a href={`/?lang=${lang}#contact`} class="gsap-nav text-slate-600 hover:text-slate-900 font-medium">{t.navContact}</a>

          <!-- Language Switcher Desktop -->
          <div class="gsap-nav inline-flex items-center rounded-lg border border-slate-200 bg-slate-100 p-0.5 text-xs font-bold">
            <a
              href={`/study/${encodeURIComponent(decodedSlug)}?lang=id`}
              class={`px-2 py-1 rounded-md transition-colors ${!isEn ? 'bg-white text-slate-900 shadow-2xs' : 'text-slate-500 hover:text-slate-900'}`}
            >
              ID
            </a>
            <a
              href={`/study/${encodeURIComponent(decodedSlug)}?lang=en`}
              class={`px-2 py-1 rounded-md transition-colors ${isEn ? 'bg-white text-slate-900 shadow-2xs' : 'text-slate-500 hover:text-slate-900'}`}
            >
              EN
            </a>
          </div>

          <a
            href="https://www.linkedin.com/in/mahardhikaadiningrat/"
            target="_blank"
            rel="noopener noreferrer"
            class="gsap-nav gsap-btn inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-slate-900 text-white font-semibold hover:bg-emerald-600"
          >
            <span>{t.navLinkedin}</span>
            <span class="text-xs">↗</span>
          </a>
        </nav>

        <!-- Mobile Controls -->
        <div class="flex md:hidden items-center gap-2">
          <div class="inline-flex items-center rounded-lg border border-slate-200 bg-slate-100 p-0.5 text-[11px] font-bold">
            <a
              href={`/study/${encodeURIComponent(decodedSlug)}?lang=id`}
              class={`px-2 py-1 rounded-md ${!isEn ? 'bg-white text-slate-900 shadow-2xs' : 'text-slate-500'}`}
            >
              ID
            </a>
            <a
              href={`/study/${encodeURIComponent(decodedSlug)}?lang=en`}
              class={`px-2 py-1 rounded-md ${isEn ? 'bg-white text-slate-900 shadow-2xs' : 'text-slate-500'}`}
            >
              EN
            </a>
          </div>

          <button
            id="mobile-menu-btn"
            type="button"
            aria-label="Open Navigation Menu"
            aria-expanded="false"
            class="inline-flex items-center justify-center p-2 rounded-lg text-slate-700 hover:text-slate-900 hover:bg-slate-100"
          >
            <svg id="icon-hamburger" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <div id="scroll-progress" class="h-[2px] bg-emerald-600 origin-left scale-x-0 w-full"></div>

      <!-- Mobile Dropdown Menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-6 py-4 space-y-3 shadow-sm overflow-hidden">
        <a href={`/?lang=${lang}#careers`} class="mobile-nav-link block py-1.5 text-sm font-medium text-slate-700 hover:text-emerald-600">
          {t.navCareers}
        </a>
        <a href={`/?lang=${lang}#studies`} class="mobile-nav-link block py-1.5 text-sm font-medium text-slate-700 hover:text-emerald-600">
          {t.navStudies}
        </a>
        <a href={`/?lang=${lang}#contact`} class="mobile-nav-link block py-1.5 text-sm font-medium text-slate-700 hover:text-emerald-600">
          {t.navContact}
        </a>
        <div class="pt-2 border-t border-slate-100">
          <a
            href="https://www.linkedin.com/in/mahardhikaadiningrat/"
            target="_blank"
            rel="noopener noreferrer"
            class="mobile-nav-link w-full inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-900 text-white text-sm font-semibold hover:bg-emerald-600"
          >
            <span>{t.navLinkedin}</span>
            <span class="text-xs">↗</span>
          </a>
        </div>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-12 space-y-12">
      <!-- Breadcrumb & Header Case Study -->
      <section class="space-y-5">
        <div class="hero-item flex flex-wrap items-center gap-2 text-xs text-slate-500">
          <a href={`/?lang=${lang}`} class="hover:text-slate-900 font-medium">{t.backPortfolio}</a>
          {career && (
            <>
              <span>/</span>
              <a href={`/career/${career.id}?lang=${lang}`} class="text-emerald-600 font-semibold hover:underline">
                {career.company}
              </a>
            </>
          )}
        </div>

        <div class="hero-item flex flex-wrap gap-2">
          {categories.map((cat) => (
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
              {cat}
            </span>
          ))}
        </div>

        <h1 class="hero-item text-3xl md:text-4xl font-bold tracking-tight text-slate-900 leading-tight">
          {study.title}
        </h1>

        {study.subtitle && (
          <p class="hero-item text-base md:text-lg text-slate-600 leading-relaxed">
            {study.subtitle}
          </p>
        )}

        {study.live_url && (
          <div class="hero-item pt-1">
            <a
              href={study.live_url}
              target="_blank"
              rel="noopener noreferrer"
              class="gsap-btn inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 text-white text-xs font-bold hover:bg-emerald-600"
            >
              <span>{t.visitLive}</span>
              <span>↗</span>
            </a>
          </div>
        )}
      </section>

      <!-- Galeri Slider / Carousel + Lightbox -->
      {photos.length > 0 && (
        <section class="reveal-section space-y-4">
          <div class="reveal-header flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2.5">
              <h2 class="text-lg font-bold text-slate-900">{t.visualHeading}</h2>
              {photos.length > 1 && (
                <span id="slider-counter" class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-slate-900 text-white">
                  1 / {photos.length}
                </span>
              )}
            </div>
            <span class="text-xs text-slate-500">{t.zoomHint}</span>
          </div>

          <div
            id="study-slider"
            class="reveal-card relative rounded-2xl bg-white border border-slate-200 overflow-hidden shadow-xs select-none"
          >
            <!-- Viewport & Track -->
            <div class="overflow-hidden bg-slate-100">
              <div
                id="slider-track"
                class="flex transition-transform duration-500 ease-out"
                style="transform: translateX(0%);"
              >
                {photos.map((photo, idx) => (
                  <div class="w-full shrink-0 flex flex-col">
                    <div class="relative w-full aspect-16/10 bg-slate-100 flex items-center justify-center overflow-hidden group">
                      <img
                        src={photo.url}
                        alt={photo.caption || `${study.title} — ${idx + 1}`}
                        loading={idx === 0 ? 'eager' : 'lazy'}
                        data-lightbox-src={photo.url}
                        data-lightbox-caption={photo.caption || ''}
                        data-slide-idx={idx}
                        class="lightbox-trigger w-full h-full object-contain cursor-zoom-in transition-transform duration-300 group-hover:scale-[1.01]"
                      />
                    </div>
                    {photo.caption && (
                      <div class="px-5 py-3.5 text-xs md:text-sm text-slate-600 border-t border-slate-100 bg-white leading-relaxed">
                        {photo.caption}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>

            <!-- Tombol Navigasi Prev / Next (tampil jika gambar > 1) -->
            {photos.length > 1 && (
              <>
                <button
                  id="slider-prev"
                  type="button"
                  aria-label="Previous image"
                  class="absolute left-3 top-[42%] -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white/95 hover:bg-slate-900 text-slate-900 hover:text-white border border-slate-200 shadow-md flex items-center justify-center transition-colors cursor-pointer"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                  </svg>
                </button>

                <button
                  id="slider-next"
                  type="button"
                  aria-label="Next image"
                  class="absolute right-3 top-[42%] -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white/95 hover:bg-slate-900 text-slate-900 hover:text-white border border-slate-200 shadow-md flex items-center justify-center transition-colors cursor-pointer"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </button>

                <!-- Pagination Dots + Thumbnail Strip -->
                <div class="px-5 py-3 bg-slate-50/90 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
                  <div class="flex items-center gap-2 overflow-x-auto py-0.5">
                    {photos.map((photo, idx) => (
                      <button
                        type="button"
                        data-goto={idx}
                        aria-label={`Slide ${idx + 1}`}
                        class={`slider-thumb relative w-14 h-9 rounded-lg overflow-hidden border-2 transition-all shrink-0 cursor-pointer ${
                          idx === 0 ? 'border-emerald-600 opacity-100 scale-105' : 'border-transparent opacity-60 hover:opacity-100'
                        }`}
                      >
                        <img src={photo.url} alt="" class="w-full h-full object-cover" />
                      </button>
                    ))}
                  </div>

                  <div class="flex items-center gap-1.5">
                    {photos.map((_, idx) => (
                      <button
                        type="button"
                        data-goto={idx}
                        aria-label={`Go to slide ${idx + 1}`}
                        class={`slider-dot h-2 rounded-full transition-all cursor-pointer ${
                          idx === 0 ? 'w-6 bg-emerald-600' : 'w-2 bg-slate-300 hover:bg-slate-400'
                        }`}
                      />
                    ))}
                  </div>
                </div>
              </>
            )}
          </div>
        </section>
      )}

      <!-- Tantangan / Latar Belakang -->
      {study.challenge && (
        <section class="reveal-section rounded-2xl bg-white border border-slate-200 p-6 md:p-8 shadow-xs space-y-3">
          <div class="reveal-item text-xs font-bold uppercase tracking-wider text-slate-400">
            {t.secChallenge}
          </div>
          <p class="reveal-item text-slate-700 leading-relaxed text-sm md:text-base">
            {study.challenge}
          </p>
        </section>
      )}

      <!-- Penjabaran Pekerjaan & Hasil Pekerjaan -->
      <div class="grid md:grid-cols-2 gap-6">
        {execution.length > 0 && (
          <section class="reveal-section rounded-2xl bg-white border border-slate-200 p-6 md:p-8 shadow-xs space-y-4">
            <div class="reveal-item text-xs font-bold uppercase tracking-wider text-slate-400">
              {t.secExecution}
            </div>
            <ul class="space-y-3">
              {execution.map((item) => (
                <li class="reveal-item flex items-start gap-3 text-sm text-slate-700 leading-relaxed">
                  <span class="w-1.5 h-1.5 rounded-full bg-slate-900 mt-2 shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {results.length > 0 && (
          <section class="reveal-section rounded-2xl bg-emerald-50/60 border border-emerald-200 p-6 md:p-8 shadow-xs space-y-4">
            <div class="reveal-item text-xs font-bold uppercase tracking-wider text-emerald-700">
              {t.secResults}
            </div>
            <ul class="space-y-3">
              {results.map((item) => (
                <li class="reveal-item flex items-start gap-3 text-sm text-slate-800 font-medium leading-relaxed">
                  <span class="text-emerald-600 font-bold mt-0.5 shrink-0">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <!-- CTA Bawah -->
      <section class="reveal-section rounded-2xl bg-white border border-slate-200 p-6 md:p-8 shadow-xs flex flex-wrap items-center justify-between gap-4">
        <div class="reveal-item space-y-1">
          <h3 class="text-base font-bold text-slate-900">{t.ctaTitle}</h3>
          <p class="text-xs text-slate-600">{t.ctaDesc}</p>
        </div>
        <div class="reveal-item flex flex-wrap items-center gap-3">
          <a
            href="mailto:mahardhikadiningrat@gmail.com"
            class="gsap-btn px-4 py-2.5 rounded-xl bg-slate-900 text-white text-xs font-bold hover:bg-slate-800"
          >
            {t.ctaEmail}
          </a>
          <a
            href={`/?lang=${lang}#studies`}
            class="gsap-btn px-4 py-2.5 rounded-xl bg-slate-100 text-slate-800 text-xs font-bold hover:bg-slate-200"
          >
            {t.ctaMore}
          </a>
        </div>
      </section>
    </main>

    <!-- Lightbox Modal Layar Penuh -->
    <div
      id="lightbox-modal"
      class="fixed inset-0 z-50 hidden bg-slate-950/90 backdrop-blur-xs flex items-center justify-center p-4 md:p-8"
      role="dialog"
      aria-modal="true"
    >
      <button
        id="lightbox-close"
        type="button"
        aria-label="Close fullscreen preview"
        class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/15 hover:bg-white/30 text-white flex items-center justify-center cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="max-w-5xl w-full flex flex-col items-center gap-3">
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="max-h-[80vh] w-auto rounded-xl shadow-2xl border border-white/10 object-contain"
        />
        <p id="lightbox-caption" class="text-xs md:text-sm text-slate-200 text-center max-w-2xl"></p>
      </div>
    </div>

    <footer class="border-t border-slate-200 bg-white mt-12">
      <div class="max-w-6xl mx-auto px-6 py-6 flex flex-wrap items-center justify-between gap-4 text-xs text-slate-500">
        <span>© {new Date().getFullYear()} Mahardhika Adiningrat. All rights reserved.</span>
        <div class="flex items-center gap-5">
          <a href={`/?lang=${lang}#careers`} class="hover:text-slate-900">{t.navCareers}</a>
          <a href={`/?lang=${lang}#studies`} class="hover:text-slate-900">{t.footerStudies}</a>
          <a href={`/?lang=${lang}#contact`} class="hover:text-slate-900">{t.navContact}</a>
          <a href="https://www.linkedin.com/in/mahardhikaadiningrat/" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900">LinkedIn</a>
        </div>
      </div>
    </footer>

    <style is:global>
      html.lenis, html.lenis body { height: auto; }
      .lenis.lenis-smooth { scroll-behavior: auto !important; }
      .lenis.lenis-stopped { overflow: hidden; }
    </style>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { initSmoothScroll } from '../../scripts/smooth-scroll';

      gsap.registerPlugin(ScrollTrigger);

      const lenis = initSmoothScroll({
        progressBarSelector: '#scroll-progress',
      });

      const heroTl = gsap.timeline({ defaults: { ease: 'power3.out', duration: 0.7 } });
      heroTl
        .from('.gsap-logo', { x: -16, scale: 0.9, opacity: 0, clearProps: 'transform' })
        .from('.gsap-nav', { y: -12, opacity: 0, stagger: 0.06, clearProps: 'transform' }, '-=0.5')
        .from('.hero-item', { y: 28, skewY: 1, opacity: 0, stagger: 0.06, clearProps: 'transform' }, '-=0.45');

      document.querySelectorAll('.reveal-section').forEach((section) => {
        const headerEls = section.querySelectorAll('.reveal-header');
        const cardEls = section.querySelectorAll('.reveal-card');
        const itemEls = section.querySelectorAll('.reveal-item');

        const tl = gsap.timeline({
          scrollTrigger: { trigger: section, start: 'top 86%', once: true },
          defaults: { ease: 'power3.out', duration: 0.65 },
        });

        if (headerEls.length) {
          tl.from(headerEls, { y: 22, clipPath: 'inset(0% 0% 100% 0%)', opacity: 0, stagger: 0.06, clearProps: 'clipPath,transform' });
        }
        if (cardEls.length) {
          tl.from(cardEls, { y: 28, scale: 0.96, opacity: 0, stagger: 0.06, clearProps: 'transform' }, headerEls.length ? '-=0.4' : 0);
        }
        if (itemEls.length) {
          tl.from(itemEls, { y: 22, opacity: 0, stagger: 0.06, clearProps: 'transform' }, '-=0.35');
        }
      });

      document.querySelectorAll('.gsap-btn').forEach((btn) => {
        btn.addEventListener('mouseenter', () => gsap.to(btn, { y: -2, scale: 1.02, duration: 0.25, ease: 'power3.out' }));
        btn.addEventListener('mouseleave', () => gsap.to(btn, { y: 0, scale: 1, duration: 0.25, ease: 'power3.out' }));
      });

      // --- Logika Slider / Carousel ---
      const sliderTrack = document.getElementById('slider-track') as HTMLElement | null;
      const sliderEl = document.getElementById('study-slider');
      const prevBtn = document.getElementById('slider-prev');
      const nextBtn = document.getElementById('slider-next');
      const counterEl = document.getElementById('slider-counter');
      const dots = Array.from(document.querySelectorAll('.slider-dot'));
      const thumbs = Array.from(document.querySelectorAll('.slider-thumb'));
      const totalSlides = sliderTrack ? sliderTrack.children.length : 0;
      let currentSlide = 0;

      function goToSlide(index: number) {
        if (!sliderTrack || totalSlides <= 1) return;
        currentSlide = (index + totalSlides) % totalSlides;
        sliderTrack.style.transform = `translateX(-${currentSlide * 100}%)`;

        if (counterEl) {
          counterEl.textContent = `${currentSlide + 1} / ${totalSlides}`;
        }

        dots.forEach((dot, i) => {
          dot.className = `slider-dot h-2 rounded-full transition-all cursor-pointer ${
            i === currentSlide ? 'w-6 bg-emerald-600' : 'w-2 bg-slate-300 hover:bg-slate-400'
          }`;
        });

        thumbs.forEach((thumb, i) => {
          thumb.className = `slider-thumb relative w-14 h-9 rounded-lg overflow-hidden border-2 transition-all shrink-0 cursor-pointer ${
            i === currentSlide
              ? 'border-emerald-600 opacity-100 scale-105'
              : 'border-transparent opacity-60 hover:opacity-100'
          }`;
        });
      }

      prevBtn?.addEventListener('click', () => goToSlide(currentSlide - 1));
      nextBtn?.addEventListener('click', () => goToSlide(currentSlide + 1));

      document.querySelectorAll('[data-goto]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = Number(btn.getAttribute('data-goto'));
          if (!Number.isNaN(target)) goToSlide(target);
        });
      });

      // Dukungan Swipe di HP / Touchscreen
      let touchStartX = 0;
      sliderEl?.addEventListener(
        'touchstart',
        (e) => {
          touchStartX = e.changedTouches[0].clientX;
        },
        { passive: true }
      );
      sliderEl?.addEventListener(
        'touchend',
        (e) => {
          const deltaX = e.changedTouches[0].clientX - touchStartX;
          if (Math.abs(deltaX) > 45) {
            goToSlide(deltaX < 0 ? currentSlide + 1 : currentSlide - 1);
          }
        },
        { passive: true }
      );

      // --- Logika Lightbox Zoom ---
      const lightboxModal = document.getElementById('lightbox-modal');
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      const lightboxCaption = document.getElementById('lightbox-caption');
      const lightboxClose = document.getElementById('lightbox-close');

      function openLightbox(src: string, caption: string) {
        if (!lightboxModal || !lightboxImg) return;
        lightboxImg.src = src;
        if (lightboxCaption) lightboxCaption.textContent = caption || '';
        lightboxModal.classList.remove('hidden');
        lenis.stop();
      }

      function closeLightbox() {
        if (!lightboxModal) return;
        lightboxModal.classList.add('hidden');
        lenis.start();
      }

      document.querySelectorAll('.lightbox-trigger').forEach((img) => {
        img.addEventListener('click', () => {
          const src = img.getAttribute('data-lightbox-src') || '';
          const caption = img.getAttribute('data-lightbox-caption') || '';
          if (src) openLightbox(src, caption);
        });
      });

      lightboxClose?.addEventListener('click', closeLightbox);
      lightboxModal?.addEventListener('click', (e) => {
        if (e.target === lightboxModal) closeLightbox();
      });

      // Navigasi Keyboard (Panah Kiri/Kanan & Escape)
      window.addEventListener('keydown', (e) => {
        if (lightboxModal && !lightboxModal.classList.contains('hidden')) {
          if (e.key === 'Escape') closeLightbox();
          return;
        }
        if (totalSlides > 1) {
          if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
          if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
        }
      });

      // Mobile Menu
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const iconHamburger = document.getElementById('icon-hamburger');
      const iconClose = document.getElementById('icon-close');
      let isMenuOpen = false;

      function setMobileMenu(open: boolean) {
        if (!mobileMenu || !menuBtn || !iconHamburger || !iconClose) return;
        isMenuOpen = open;
        menuBtn.setAttribute('aria-expanded', String(open));
        iconHamburger.classList.toggle('hidden', open);
        iconClose.classList.toggle('hidden', !open);

        if (open) {
          lenis.stop();
          mobileMenu.classList.remove('hidden');
          gsap.fromTo(mobileMenu, { height: 0, opacity: 0 }, { height: 'auto', opacity: 1, duration: 0.35, ease: 'power3.out', clearProps: 'height' });
          gsap.from('.mobile-nav-link', { x: -14, opacity: 0, stagger: 0.06, duration: 0.35, ease: 'power3.out', clearProps: 'transform' });
        } else {
          lenis.start();
          gsap.to(mobileMenu, {
            height: 0,
            opacity: 0,
            duration: 0.25,
            ease: 'power3.out',
            onComplete: () => {
              mobileMenu.classList.add('hidden');
              gsap.set(mobileMenu, { clearProps: 'all' });
            },
          });
        }
      }

      menuBtn?.addEventListener('click', () => setMobileMenu(!isMenuOpen));
      document.querySelectorAll('.mobile-nav-link').forEach((link) => {
        link.addEventListener('click', () => {
          if (isMenuOpen) setMobileMenu(false);
        });
      });
    </script>
  </body>
</html>