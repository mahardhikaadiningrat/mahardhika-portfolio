{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/careers/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/seed/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/studies/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/upload/?$",
			"dest": "_render"
		},
		{
			"src": "^/career/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/src/lib/db/?$",
			"dest": "_render"
		},
		{
			"src": "^/src/lib/defaultData/?$",
			"dest": "_render"
		},
		{
			"src": "^/study/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render"
		}
	]
}